{
  "id": "library.open-library-search",
  "version": "1.0.0",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "default": "",
        "type": "string",
        "maxLength": 200
      },
      "kind": {
        "type": "string",
        "enum": [
          "lottie",
          "texture",
          "hdri"
        ]
      },
      "limit": {
        "default": 24,
        "type": "integer",
        "minimum": 1,
        "maximum": 96
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "thumbnailUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "license": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            },
            "attributionRequired": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "kind",
            "name",
            "source",
            "thumbnailUrl",
            "license",
            "credit",
            "attributionRequired"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "items"
    ],
    "additionalProperties": false
  }
}
