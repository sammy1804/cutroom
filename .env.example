# ─────────────────────────────────────────────────────────────
# Cutroom — environment configuration
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cutroom

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://localhost:5432/cutroom
# Used by `pnpm test` integration tests. Wiped and re-migrated on each run.
TEST_DATABASE_URL=postgresql://localhost:5432/cutroom_test

# Auth (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32+-character-random-string
BETTER_AUTH_URL=http://localhost:3000

# Email delivery for invitations / verification.
# "console" logs messages to the server output (development only).
EMAIL_PROVIDER=console
EMAIL_FROM="Cutroom <studio@example.com>"

# ── Provider slots (Phase 2+) ────────────────────────────────
# Each capability resolves to a provider id. "none" = not configured.
# Phase 1 ships interfaces only; no generation is performed.
LLM_PROVIDER=anthropic
RESEARCH_PROVIDER=anthropic
IMAGE_PROVIDER=none
VIDEO_PROVIDER=none
VOICE_PROVIDER=none
RENDER_PROVIDER=none
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.storage

# Provider credentials
# Claude powers research, reference analysis, CreativeDNA, asset ranking,
# animation search and the command bar. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional free-asset providers (Openverse and Wikimedia need no key)
# https://www.pexels.com/api/  ·  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=
